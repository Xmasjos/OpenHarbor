<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <ProjectReference Include="..\OpenHarbor.PluginContracts\OpenHarbor.PluginContracts.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Include="public\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PackageTodoPlugin" AfterTargets="Build">
    <PropertyGroup>
      <TodoPackageStage>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)todo-package</TodoPackageStage>
      <TodoPackagePath>$(MSBuildProjectDirectory)/artifacts/OpenHarbor.Todo.zip</TodoPackagePath>
    </PropertyGroup>
    <ItemGroup>
      <_TodoPublicAsset Include="$(TargetDir)public/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(TodoPackageStage)" />
    <MakeDir Directories="$(TodoPackageStage)/public;$(MSBuildProjectDirectory)/artifacts" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TodoPackageStage)" />
    <Copy
      SourceFiles="@(_TodoPublicAsset)"
      DestinationFiles="@(_TodoPublicAsset->'$(TodoPackageStage)/public/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(TodoPackageStage)" DestinationFile="$(TodoPackagePath)" Overwrite="true" />
  </Target>

</Project>
