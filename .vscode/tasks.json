{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch: OpenHarbor",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/OpenHarbor/OpenHarbor.csproj",
                "run",
                "--launch-profile",
                "https"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}